# Environment variables for the Mira container.
# Consumed by docker-compose.yml via `env_file: .env` — plain KEY=value,
# no `export` prefix (that is only needed when sourcing the file in a shell).
# Copy this file to .env and fill in real values. Never commit .env.

# Public hostname of this deployment (rendered into the nginx TLS vhost).
# Must match the certificate in deploy/nginx/certs/.
MIRA_DOMAIN=mira.example.com

# Database
DATABASE_URL=postgresql://mira:mira@localhost:5432/mira

# GitHub App
MIRA_GITHUB_APP_ID=123456
MIRA_GITHUB_PRIVATE_KEY_PATH=./private-key.pem
MIRA_WEBHOOK_SECRET=your_webhook_secret_here
# Optional: override for GitHub Enterprise Server.
# Examples:
#   MIRA_GITHUB_API_URL=https://github.acme-corp.com/api/v3
#   MIRA_GITHUB_GRAPHQL_URL=https://github.acme-corp.com/api/graphql
# Optional: bot login override for self-checks. Defaults to "miracodeai".
# MIRA_BOT_NAME=miracodeai

# Self-hosted Forgejo
# MIRA_FORGEJO_API_URL=https://git.example.com/api/v1
# The web base is inferred by removing the trailing /api/v1 (subpaths preserved).
# For a nonstandard API URL, an explicit web base is required:
# MIRA_FORGEJO_BASE_URL=https://git.example.com

# LLM (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
MIRA_MODEL=anthropic/claude-sonnet-4-6

# Dashboard
# Initial admin password. If unset, a random password is generated on first
# start and written to <MIRA_INDEX_DIR>/initial_admin_password (mode 0600).
# Never use a guessable value here.
# ADMIN_PASSWORD=
MIRA_INDEX_DIR=./data/indexes
